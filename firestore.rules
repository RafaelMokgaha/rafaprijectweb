/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and game requests.
 * Only the authenticated user can read or write their own profile and game requests.
 * Available games are publicly readable but only writeable through backend processes (not covered by these rules).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, where userId matches the Firebase Authentication UID.
 * - /users/{userId}/game_requests/{gameRequestId}: Stores game requests submitted by users, nested under the user's profile.
 * - /available_games/{availableGameId}: Stores information about available games.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and game requests.
 * - Listing all users is disallowed.
 * - Available games are publicly readable but not writable via client.
 *
 * Denormalization for Authorization:
 * - Game requests are stored as subcollections of user profiles, inheriting the user ID for simplified authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create, update, get, delete) if the request is made by the user with matching {userId}.
     * @deny (create, update, get, delete) if the request is made by a different user or unauthenticated user.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to game requests for a specific user.
     * @path /users/{userId}/game_requests/{gameRequestId}
     * @allow (create, update, get, delete) if the request is made by the user with matching {userId}.
     * @deny (create, update, get, delete) if the request is made by a different user or unauthenticated user.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/game_requests/{gameRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing game requests is not permitted

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to available game documents.  Read access is public, but writes are not permitted via the client.
     * @path /available_games/{availableGameId}
     * @allow (get, list) to anyone.
     * @deny (create, update, delete) to everyone.
     * @principle Public read, owner-only write (backend only).
     */
    match /available_games/{availableGameId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }
  }
}