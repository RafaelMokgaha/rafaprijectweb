/**
 * @fileoverview Firestore Security Rules for RAFA Project.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and messages,
 * and public read access for available games and game requests.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the authenticated user can read/write their own profile.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user. Only the user can manage their messages.
 * - /game_requests/{gameRequestId}: Stores game requests. Publicly readable, but writes are not permitted in this prototype.
 * - /available_games/{availableGameId}: Stores available games. Publicly readable, but writes are not permitted in this prototype.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed (no `list` on `/users`).
 * - Write operations for /game_requests and /available_games are not permitted in this prototype.
 *
 * Denormalization for Authorization:
 *  N/A - Not needed based on requirements.
 *
 * Structural Segregation:
 *  Private user data is segregated under the `/users/{userId}` path, while public data resides in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - User 'testUID' can create their own profile if request.auth.uid == 'testUID'.
     * @allow (get, update, delete) - User 'testUID' can get, update, and delete their own profile.
     * @deny (create) - User 'anotherUID' cannot create a profile with ID 'testUID'.
     * @deny (get, update, delete) - User 'anotherUID' cannot get, update or delete user 'testUID' profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure messages sent to a specific user. Only the user can manage their messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) - User 'testUID' can create messages in their own messages collection.
     * @allow (get, list, update, delete) - User 'testUID' can read, list, update, and delete messages in their own messages collection.
     * @deny (create) - User 'anotherUID' cannot create messages in user 'testUID' messages collection.
     * @deny (get, list, update, delete) - User 'anotherUID' cannot read, list, update, or delete messages in user 'testUID' messages collection.
     * @principle Restricts access to a user's own message inbox.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allow public read access to available games. Write operations are not permitted in this prototype.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Any user can read available games.
     * @deny (create, update, delete) - No one can create, update, or delete available games in this prototype.
     * @principle Public read access with no write permissions.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to game requests. Write operations are not permitted in this prototype.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) - Any user can read game requests.
     * @deny (create, update, delete) - No one can create, update, or delete game requests in this prototype.
     * @principle Public read access with no write permissions.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}