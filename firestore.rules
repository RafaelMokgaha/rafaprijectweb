/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and their associated game requests.
 * Available games are publicly readable but not writable by clients.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. 'userId' must match the Firebase Authentication UID.
 * - /users/{userId}/game_requests/{gameRequestId}: Stores game requests submitted by users. 'userId' must match the user who created the request.
 * - /available_games/{availableGameId}: Stores information about available games. Publicly readable.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Users can only create, update, and delete their own game requests.
 * - Listing available games is permitted for all users.
 * - Game requests are stored as subcollections of users and contain a denormalized `userAccountId` field for authorization.
 *
 * Denormalization for Authorization:
 * - The `GameRequest` entity includes a `userAccountId` field that duplicates the `userId` from the path.
 *   This denormalization enables simple, performant rules for game requests without requiring complex path traversal.
 *   The rules enforce consistency between the `userId` path parameter and the `userAccountId` field in the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile information.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) Authenticated user can read, update, and delete their own profile if the userId matches their auth UID.
     * @deny (create) Authenticated user cannot create a profile with a userId that doesn't match their auth UID.
     * @deny (get, update, delete) Authenticated user cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.email is string && request.resource.data.profileComplete is bool;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages game requests submitted by users.
     * @path /users/{userId}/game_requests/{gameRequestId}
     * @allow (create) Authenticated user can create a game request under their user profile if the userId matches their auth UID and userAccountId.
     * @allow (get, update, delete) Authenticated user can read, update, and delete their own game requests.
     * @deny (create) Authenticated user cannot create a game request with a userId that doesn't match their auth UID or userAccountId.
     * @deny (get, update, delete) Authenticated user cannot read, update, or delete another user's game requests.
     * @principle Enforces document ownership for writes and validates relational integrity.
     */
    match /users/{userId}/game_requests/{gameRequestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userAccountId == userId && request.resource.data.id == gameRequestId;
      allow update: if isExistingOwner(userId) && resource.data.userAccountId == userId && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages information about available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user can read the list of available games.
     * @deny (create, update, delete) No user can create, update, or delete available games (admin only).
     * @principle Public read, admin-only write.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}