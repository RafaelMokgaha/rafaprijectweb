/**
 * @fileoverview Firestore Security Rules for RAFA Project.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages.
 * Game requests and available games are open to read, but only admins can modify them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the user can read/write their own profile.
 * - /game_requests/{gameRequestId}: Stores user game requests. Publicly readable, but only admins can modify.
 * - /available_games/{availableGameId}: Stores available games. Publicly readable, but only admins can modify.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user. Only the user can read/write their own messages.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed by the rules structure.
 * - Game requests and available games are publicly readable to facilitate discovery and engagement.
 * - Admin role is not defined. All write operations for game requests and available games are denied.
 *
 * Authorization Independence:
 * No data denormalization is required as path-based ownership and structural segregation provide sufficient security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create, update, delete) User with matching UID can modify their own profile.
     * @deny (create, update, delete) User cannot modify another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) Public read access for all game requests.
     * @deny (create, update, delete) No write access allowed; admin role is not implemented
     * @principle Public read access with restricted writes.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin role validation for write access.
    }

    /**
     * @description Controls access to available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Public read access for all available games.
     * @deny (create, update, delete) No write access allowed; admin role is not implemented
     * @principle Public read access with restricted writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin role validation for write access.
    }

    /**
     * @description Controls access to messages for a specific user.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create, update, delete) User with matching UID can modify their own messages.
     * @deny (create, update, delete) User cannot modify another user's messages.
     * @principle Enforces document ownership for writes in a subcollection.
     */
    match /users/{userId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}