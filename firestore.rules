/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and allows public read access to collections intended for general consumption.
 * Authorization decisions are based on the authenticated user's ID (`request.auth.uid`).
 *
 * Data Structure:
 * - /game_requests/{gameRequestId}: Stores game requests.
 * - /available_games/{availableGameId}: Stores information about available games.
 * - /users/{userId}: Stores user account information, using path-based ownership.
 * - /users/{userId}/messages/{messageId}: Stores user messages, using path-based ownership.
 * - /login_events/{loginEventId}: Stores user login events.
 *
 * Key Security Decisions:
 * - User data is strictly private, accessible only to the authenticated user.
 * - Game requests and available games are publicly readable.
 * - Listing of messages is restricted to the owner of the messages.
 *
 * Denormalization for Authorization:
 * - User-specific data (e.g., messages) is stored under the user's path, enabling
 *   path-based authorization and avoiding the need for `get()` calls.
 *
 * Structural Segregation:
 * - Private user data (messages) is stored in a subcollection under the user's document,
 *   ensuring that it is not publicly accessible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game requests, but restricts creation, update, and deletion.
     * @path /game_requests/{gameRequestId}
     * @allow get, list: if true
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Allows public read access for game requests but protects against unauthorized modifications.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read available games, but restricts creation, update, and deletion.
     * @path /available_games/{availableGameId}
     * @allow get, list: if true
     * @deny create: if false
     * @deny update: if false
     * @deny delete: if false
     * @principle Allows public read access for available games but protects against unauthorized modifications.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages user accounts, allowing users to create their own account and read/write their own data.
     * @path /users/{userId}
     * @allow create: if request.auth.uid == userId
     * @allow get: if isOwner(userId)
     * @allow list: if false
     * @allow update: if isExistingOwner(userId)
     * @allow delete: if isExistingOwner(userId)
     * @principle Enforces document ownership for user accounts, ensuring only the user can access their own data.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user messages, restricting access to the owner of the messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow create: if isOwner(userId)
     * @allow get: if isOwner(userId)
     * @allow list: if isOwner(userId)
     * @allow update: if isExistingOwner(userId)
     * @allow delete: if isExistingOwner(userId)
     * @principle Enforces document ownership for user messages, ensuring only the user can access their own messages.
     */
    match /users/{userId}/messages/{messageId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Restricts all access to login events.
      * @path /login_events/{loginEventId}
      * @allow get: if false;
      * @allow list: if false;
      * @allow create: if false;
      * @allow update: if false;
      * @allow delete: if false;
      * @principle Restricts access to login events.
      */
    match /login_events/{loginEventId} {
       allow get: if false;
       allow list: if false;
       allow create: if false;
       allow update: if false;
       allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}