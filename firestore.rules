/**
 * @fileoverview Firestore Security Rules for the RAFA Project platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages,
 * and public read access for available games. Game requests are publicly writeable but must be associated with a valid user id on creation.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profiles, accessible only to the owning user.
 * - `/game_requests/{gameRequestId}`: Stores game requests, publicly readable, writeable by authenticated users.
 * - `/available_games/{availableGameId}`: Stores available games, publicly readable, writeable by platform admins (currently not implemented, write access is disabled).
 * - `/users/{userId}/messages/{messageId}`: Stores messages for specific users, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Messages are private and only accessible to the recipient user.
 * - Listing of users and messages is restricted to the owning user.
 * - Available games are publicly readable.
 * - Game requests can be created by all authenticated users, but admins are responsible for managing these.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profile data, enforcing strict ownership.
     * @path /users/{userId}
     * @allow (get, list, update, delete) if the request is made by the user with matching {userId}.
     * @allow (create) if the authenticated user's UID matches the {userId} parameter.
     * @deny (get, list, update, delete) if the request is made by a different user.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access and authenticated user write access to game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) if true (publicly readable).
     * @allow (create) if the request is authenticated and the userId matches the authenticated user's id.
     * @allow (update, delete) if false. // TODO: Add admin-only write access.
     * @deny (create, update, delete) if the request is unauthenticated.
     * @principle Allows public reads and authenticated writes for game requests, with ownership validation on create.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // TODO: Add admin-only write access.
    }

    /**
     * @description Allows public read access to available games, but restricts write access.
     * @path /available_games/{availableGameId}
     * @allow (get, list) if true (publicly readable).
     * @allow (create, update, delete) if false (write access disabled).
     * @principle Allows public reads for available games and restricts write operations.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages messages for each user, restricting access to the owner.
     * @path /users/{userId}/messages/{messageId}
     * @allow (get, list, create) if the request is made by the user with matching {userId}.
     * @allow (update, delete) if the request is made by the user with matching {userId} and the message exists.
     * @deny (get, list, create, update, delete) if the request is made by a different user.
     * @principle Enforces document ownership for all operations, ensuring message privacy.
     */
    match /users/{userId}/messages/{messageId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}