/**
 * @file Firestore Security Rules for the RAFA Project.
 *
 * @core_philosophy This ruleset enforces a user-ownership model for user profiles and messages,
 * while allowing public read access to available games. Game requests can be created by any
 * authenticated user.
 *
 * @data_structure
 * - /users/{userId}: Stores user profiles, accessible only to the owner.
 * - /game_requests/{gameRequestId}: Stores game requests, creatable by any authenticated user.
 * - /available_games/{availableGameId}: Stores available games, publicly readable.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user, accessible only to the owner.
 *
 * @key_security_decisions
 * - Users can only access their own profile data and messages.
 * - Any authenticated user can create game requests.
 * - Available games are publicly readable.
 * - Listing of user documents is denied to prevent enumeration.
 *
 * @denormalization_for_authorization None needed. Authorization is based on path and authentication.
 * @structural_segregation Private user data is stored under the /users/{userId} path, while
 * public data (available games) is stored in a top-level collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile with userId = 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read, update, and delete their own profile (userId = 'user123').
     * @deny (create) User with UID 'user123' cannot create a profile with userId = 'anotherUser'.
     * @deny (get, update, delete) User with UID 'user123' cannot read, update, or delete another user's profile (userId = 'anotherUser').
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to create a game request.
     * @path /game_requests/{gameRequestId}
     * @allow (create) Authenticated user can create a game request.
     * @deny (get, list, update, delete) No one can read, list, update, or delete game requests.
     * @principle Restricts all access to only authenticated users to create.
     */
    match /game_requests/{gameRequestId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user, authenticated or not, can read the available games.
     * @deny (create, update, delete) No one can create, update, or delete available games through the client.
     * @principle Allows public read access while restricting write access.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows access to messages for a specific user.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create, get, update, delete) User with UID 'user123' can create, read, update, and delete their own messages (userId = 'user123').
     * @deny (create, get, update, delete) User with UID 'user123' cannot create, read, update, or delete messages for another user (userId = 'anotherUser').
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}