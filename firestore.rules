/**
 * @fileoverview Firestore Security Rules for the RAFA Project platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and allows public read access to available games and game requests.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data. Access is restricted to the owning user.
 * - /game_requests/{gameRequestId}: Stores game requests. Read access is public, but write access is restricted.
 * - /available_games/{availableGameId}: Stores available games. Read access is public, but write access is restricted.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data under /users/{userId}.
 * - Listing of users is disallowed.
 * - Read access to game requests and available games is public.
 * - Write access to game requests and available games is restricted to authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles under /users/{userId}.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile document at /users/user123 if the document's id matches their UID.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their own profile document at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile document at /users/user123.
     * @deny (get, update, delete) - User with UID 'user456' cannot read, update, or delete the profile document at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure game requests under /game_requests/{gameRequestId}.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) - Any user can read game requests.
     * @allow (create) - Any authenticated user can create a game request.
     * @deny (update, delete) - Only the creator can update/delete game requests.
     * @principle Allows public read access but restricts write access to authenticated users.
     */
    match /game_requests/{gameRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure available games under /available_games/{availableGameId}.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Any user can read available games.
     * @allow (create) - Any authenticated user can create an available game.
     * @deny (update, delete) - No one can update or delete available games.
     * @principle Allows public read access but restricts write access to authenticated users.
     */
    match /available_games/{availableGameId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}