/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages,
 * while allowing public read access to available games. Game requests are writeable by
 * authenticated users, who are considered to be the owner, but not listable or gettable
 * by non-admin users.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data, accessible only to the user themselves.
 * - /game_requests/{gameRequestId}: Stores game requests submitted by users.
 * - /available_games/{availableGameId}: Stores publicly available game information.
 * - /users/{userId}/messages/{messageId}: Stores private messages for each user, accessible only to the user.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied by the security model.
 * - Available games are publicly readable but not writable by regular users.
 * - Game requests can be created by all authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if the user's auth UID matches the userId.
     * @deny (create, update, get, delete, list) if the user's auth UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure game requests. Any authenticated user can create a game request.
     * @path /game_requests/{gameRequestId}
     * @allow (create) Any authenticated user can create a game request.
     * @deny (get, list, update, delete) No user can perform read/write actions.
     * @principle Allows any authenticated user to create a game request.
     */
    match /game_requests/{gameRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allow public read access to available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user can read available games.
     * @deny (create, update, delete) No user can modify available games.
     * @principle Allows public read access but restricts write access.
     */
    match /available_games/{availableGameId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure messages for each user. Only the authenticated user can read and write their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create, update, get, delete, list) if the user's auth UID matches the userId.
     * @deny (create, update, get, delete, list) if the user's auth UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn();
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}