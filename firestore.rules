/**
 * @fileoverview Firestore Security Rules for RAFA Project.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and messages,
 * while allowing public read access to available games. Game requests are open to anyone.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the owner.
 * - /game_requests/{gameRequestId}: Stores game requests.
 * - /available_games/{availableGameId}: Stores available games, publicly readable.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user, accessible only by the owner.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and messages.
 * - Listing all users is disallowed.
 * - Available games are publicly readable.
 * - Game requests are open to all.
 *
 * Denormalization for Authorization:
 *  - User messages are stored as a subcollection of the user document to easily enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @allow (get) - User with UID 'user123' can read their profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (get) - User with UID 'user456' cannot read the profile at /users/user123.
     * @allow (update) - User with UID 'user123' can update their profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (update) - User with UID 'user456' cannot update the profile at /users/user123.
     * @allow (delete) - User with UID 'user123' can delete their profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (delete) - User with UID 'user456' cannot delete the profile at /users/user123.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && resource.data.id == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read and write game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (create) - Any authenticated user can create a game request.
     * @allow (get) - Any authenticated user can read a game request.
     * @allow (list) - Any authenticated user can list game requests.
     * @allow (update) - Any authenticated user can update a game request.
     * @allow (delete) - Any authenticated user can delete a game request.
     * @principle Allows public access to game requests.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read available games, but restricts writes.
     * @path /available_games/{availableGameId}
     * @allow (get) - Anyone can read available game data.
     * @allow (list) - Anyone can list available games.
     * @deny (create) - No one can create available games through client.
     * @deny (update) - No one can update available games through client.
     * @deny (delete) - No one can delete available games through client.
     * @principle Allows public read access with restricted writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows users to read and write their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) - User with UID 'user123' can create a message in their inbox at /users/user123/messages/msg1 if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a message in user123's inbox.
     * @allow (get) - User with UID 'user123' can read a message from their inbox at /users/user123/messages/msg1 if request.auth.uid == 'user123'.
     * @deny (get) - User with UID 'user456' cannot read a message from user123's inbox.
     * @allow (list) - User with UID 'user123' can list messages in their inbox at /users/user123/messages.
     * @deny (list) - User with UID 'user456' cannot list messages in user123's inbox.
     * @allow (update) - User with UID 'user123' can update a message in their inbox if request.auth.uid == 'user123'.
     * @deny (update) - User with UID 'user456' cannot update a message in user123's inbox.
     * @allow (delete) - User with UID 'user123' can delete a message from their inbox if request.auth.uid == 'user123'.
     * @deny (delete) - User with UID 'user456' cannot delete a message from user123's inbox.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.receiverId == userId;
      allow delete: if isExistingOwner(userId);
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}