/**
 * @fileoverview Firestore Security Rules for the RAFA Project.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model. User-specific data is strictly controlled via path-based ownership,
 * while game requests and available games are accessible to all authenticated users.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profiles, accessible only to the user themselves. The `userId` parameter MUST match the authenticated user's UID.
 * - /game_requests/{gameRequestId}: Stores game requests submitted by users.  Write access is restricted to authenticated users.
 * - /available_games/{availableGameId}: Stores information about games available on the platform. Read access is public to all authenticated users.
 * - /users/{userId}/messages/{messageId}: Stores messages sent to individual users.  Accessible only to the user themselves.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed by the rules structure.
 * - Data validation is relaxed to allow rapid prototyping, focusing primarily on authorization and relational integrity.
 * - The rules explicitly prevent unauthorized data modification and deletion.
 *
 * Denormalization for Authorization:
 *  - Not required; the current structure supports efficient rule-based authorization.
 *
 * Structural Segregation:
 *  - User-specific data is segregated under the `/users/{userId}` path to enforce privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User can create their own profile if the userId matches their auth UID.
     * @allow (get, list, update, delete) - User can only access their own profile.
     * @deny (create) - If the userId does not match the auth UID.
     * @deny (update, delete) - If the userId does not match the auth UID or the document doesn't exist.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure access to game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (create) - Authenticated users can create game requests.
     * @allow (get, list) - All authenticated users can view game requests.
     * @deny (update, delete) - Only admins can update or delete game requests.
     * @principle Authenticated users can create and view game requests.
     */
    match /game_requests/{gameRequestId} {
       function isSignedIn() {
          return request.auth != null;
        }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure access to available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Anyone can view available games.
     * @deny (create, update, delete) - Only admins can manage available games.
     * @principle Public read access with restricted write access.
     */
    match /available_games/{availableGameId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure access to user messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (get, list, update, delete) - User can only access their own messages.
     * @allow (create) - Only the system/admin can create messages for users.
     * @deny (create) - If the request is not from a trusted source (e.g., admin).
     * @principle Enforces document ownership for user messages.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}