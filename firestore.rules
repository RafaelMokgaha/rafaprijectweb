/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user data and messages,
 * while allowing public read access to available games and game requests.
 * User listing is denied for privacy.
 *
 * Data Structure:
 * - /game_requests/{gameRequestId}: Publicly readable collection for game requests.
 * - /available_games/{availableGameId}: Publicly readable collection for available games.
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/messages/{messageId}: User messages, accessible only by the owning user.
 * - /login_events/{loginEventId}: Login event logs, write only.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to prevent unauthorized data access.
 * - Game requests and available games are publicly readable.
 * - User profiles and messages are strictly user-owned.
 * - Login events are write-only (no reads).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game requests, but restricts write access.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) Public read access.
     * @deny (create, update, delete) No public writes allowed.
     * @principle Public read, restricted writes.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read available games, but restricts write access.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Public read access.
     * @deny (create, update, delete) No public writes allowed.
     * @principle Public read, restricted writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (get) Only the user can read their own profile.
     * @allow (create) Only the user can create their profile, and the userId must match the authenticated user's ID.
     * @allow (update) Only the user can update their own profile.
     * @allow (delete) Only the user can delete their own profile.
     * @allow (list) Listing all users is denied.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Enforces user-ownership for user messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (get) Only the user can read their own messages.
     * @allow (create) Only the user can create messages under their own user ID.
     * @allow (update) Only the user can update messages under their own user ID.
     * @allow (delete) Only the user can delete messages under their own user ID.
     * @allow (list) Only the user can list their own messages.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Allows writing login events, but denies reading or listing.
     * @path /login_events/{loginEventId}
     * @allow (create) Allows creating login events.
     * @deny (get, list, update, delete) No reading, listing, updating, or deleting login events.
     * @principle Write-only access for logging.
     */
    match /login_events/{loginEventId} {
      allow create: if true;
      allow get, list, update, delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, based on the userId.
     * @param {string} userId The user ID to compare with the authenticated user's ID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     * @param {string} userId The user ID to compare with the authenticated user's ID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}