/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model:
 *   - Public Read Access: Allows open read access to certain collections (e.g., `available_games`, `game_requests`) where the data is intended to be publicly available.
 *   - Strict User Ownership: Enforces strict user-ownership for user-specific data stored under `/users/{userId}`.
 *
 * Data Structure:
 * - `/game_requests/{gameRequestId}`: Stores publicly accessible game requests.
 * - `/available_games/{availableGameId}`: Stores publicly accessible information about available games.
 * - `/users/{userId}`: Stores private user account data.
 * - `/users/{userId}/messages/{messageId}`: Stores private user messages.
 *
 * Key Security Decisions:
 * - Public read access to `game_requests` and `available_games` is permitted.
 * - User listing is disabled for security and privacy.
 * - Write access to user-specific data is strictly limited to the authenticated user.
 *
 * Denormalization for Authorization:
 *   - User ownership is enforced using path-based rules (e.g., `/users/{userId}`).
 *   - The `userId` parameter in the path is matched against the `request.auth.uid` to ensure that only the authenticated user can access their own data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game requests, but restricts write access.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access while restricting write access to prevent unauthorized modifications.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read available games, but restricts write access.
     * @path /available_games/{availableGameId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access while restricting write access to prevent unauthorized modifications.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages user accounts, enforcing that only the authenticated user can manage their own account.
     * @path /users/{userId}
     * @allow (create) User can create their own account.
     * @allow (get, update, delete) User can only access their own account.
     * @deny (list) Prevents listing all users.
     * @deny (create, update, delete) if not signed in or trying to access another user's account.
     * @principle Enforces user-ownership for user account data.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages user messages, ensuring only the authenticated user can manage their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (get, list, create, update, delete) User can only access their own messages.
     * @deny (create, update, delete) if not signed in or trying to access another user's messages.
     * @principle Enforces user-ownership for user messages using path-based rules.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, based on the userId.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}