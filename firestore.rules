/**
 * @fileoverview Firestore Security Rules for the RAFA Project platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages,
 * while allowing public read access to available games. Game requests are secured such that only admins can delete them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /game_requests/{gameRequestId}: Stores game requests, readable by all but deletable by admins only.
 * - /available_games/{availableGameId}: Stores available games, publicly readable.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user, accessible only by that user.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and messages.
 * - Listing all users is disallowed.
 * - Available games are publicly readable.
 * - Game requests can only be deleted by admins.
 *
 * Structural Segregation:
 * User-specific data (profiles and messages) is stored under the /users/{userId} path to enforce path-based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the owner can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - User 'abc' can create their profile if request.auth.uid == 'abc'
     * @allow (get, update, delete) - User 'abc' can get, update, and delete their profile if request.auth.uid == 'abc'
     * @deny (create) - User 'def' cannot create profile with id 'abc'
     * @deny (get, update, delete) - User 'def' cannot get, update, and delete profile with id 'abc'
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not allowed.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Secure game requests. Anyone can read game requests, but only admins can delete them.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) - Any user can read and list game requests.
     * @allow (delete) - Only admins can delete game requests.
     * @deny (create, update) - No one can create or update game requests through the rules.
     * @principle Allows public read access to game requests but restricts deletion to admins.
     */
    match /game_requests/{gameRequestId} {
      function isAdmin() {
        // TODO: Replace with actual admin check
        return false;
      }
      allow get, list: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    /**
     * @description Make available games publicly readable.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Any user can read and list available games.
     * @deny (create, update, delete) - No one can create, update, or delete available games through the rules.
     * @principle Provides public read access to available game information.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure messages. Only the owner can read and write their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) - User 'abc' can create a message in their inbox if request.auth.uid == 'abc'
     * @allow (get, update, delete) - User 'abc' can get, update, and delete a message in their inbox if request.auth.uid == 'abc'
     * @deny (create) - User 'def' cannot create a message in user 'abc' inbox
     * @deny (get, update, delete) - User 'def' cannot get, update, and delete a message in user 'abc' inbox
     * @principle Enforces document ownership for all operations on user messages.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isOwner(userId) && resource.data.receiverId == userId;
      allow delete: if isOwner(userId) && resource.data.receiverId == userId;
    }
  }
}