/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data while allowing public read access to general application data.
 *
 * Data Structure:
 * - /game_requests/{gameRequestId}: Public collection for game requests.  Write access restricted.
 * - /available_games/{availableGameId}: Public collection of available games.  Write access restricted.
 * - /users/{userId}: User account information, owned by the user.
 * - /users/{userId}/messages/{messageId}: Messages for each user, owned by the user.
 *
 * Key Security Decisions:
 * - Users can only create their own user document and manage their own messages.
 * - Listing of all users is forbidden.
 * - Game requests and available games are publicly readable but write-protected.
 *
 * Denormalization for Authorization:
 * - User messages are stored in a subcollection of the user's document, enabling path-based ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to game requests, with restricted write access.
     * @path /game_requests/{gameRequestId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read, restricted write.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read-only access to available games, with restricted write access.
     * @path /available_games/{availableGameId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read, restricted write.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages user account information, enforcing user-ownership.
     * @path /users/{userId}
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny create: if !isSignedIn() || !isOwner(userId);
     * @deny get: if !isOwner(userId);
     * @deny update: if !isExistingOwner(userId);
     * @deny delete: if !isExistingOwner(userId);
     * @principle Enforces document ownership for writes, restricts listing, and validates relational integrity.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages messages for each user, enforcing user-ownership through path-based rules.
     * @path /users/{userId}/messages/{messageId}
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny create: if !isSignedIn() || !isOwner(userId);
     * @deny get: if !isOwner(userId);
     * @deny update: if !isExistingOwner(userId);
     * @deny delete: if !isExistingOwner(userId);
     * @principle Enforces document ownership for writes, restricts listing, and validates relational integrity.
     */
    match /users/{userId}/messages/{messageId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}