/**
 * @fileoverview Firestore Security Rules for the RAFA Project.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and messages,
 * allows open read access to available games, and allows any authenticated user to create a game request.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data. Only the user can read/write their own profile.
 * - /game_requests/{gameRequestId}: Stores game requests. Any authenticated user can create a game request.
 * - /available_games/{availableGameId}: Stores information about available games. Publicly readable.
 * - /users/{userId}/messages/{messageId}: Stores private messages for a user. Only the user can access their own messages.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and messages.
 * - Listing all users is disallowed.
 * - Available games are publicly readable but only writeable by admins (currently, write access is open, but TODO).
 *
 * Denormalization for Authorization:
 * - Not required in this model, as user ownership is determined by the path.
 *
 * Structural Segregation:
 * - Private user data is stored under /users/{userId} to enforce path-based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile at /users/user_abc if request.auth.uid == 'user_abc'.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update, or delete their own profile at /users/user_abc.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot get, update, or delete the profile at /users/user_abc.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures user game requests. Authenticated users can create game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (create) - User with UID 'user_abc' can create a game request.
     * @allow (get, list) - Any user can read game requests.
     * @deny (update, delete) - Only the user who created the request can update or delete it.
     * @principle Authenticated users can create, read, update, and delete their own game requests.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures available games.  Any user can read available games, but write access is only to administrators.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Any user can read available games.
     * @deny (create, update, delete) - Only administrators should be able to create, update, or delete available games.
     * @principle Allows public read access to available games, restricts write access to administrators.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures messages for a specific user. Only the user can read/write their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) - User with UID 'user_abc' can create a message in their inbox at /users/user_abc/messages/message1.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update, or delete a message in their inbox at /users/user_abc/messages/message1.
     * @deny (create) - User with UID 'user_xyz' cannot create a message in user_abc's inbox.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot get, update, or delete a message in user_abc's inbox.
     * @principle Enforces document ownership for writes, restricts access to a user's own message inbox.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}