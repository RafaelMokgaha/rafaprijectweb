/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, user-centric data model with clear ownership.
 * It uses path-based authorization wherever possible to ensure that users can only
 * access their own data. Public read access is granted only where explicitly
 * intended, such as for available games.
 *
 * Data Structure:
 * - /game_requests/{gameRequestId}: Stores game requests submitted by users.
 * - /available_games/{availableGameId}: Stores information about available games.
 * - /users/{userId}: Stores user account information, with the userId matching the Firebase auth UID.
 * - /users/{userId}/messages/{messageId}: Stores messages for each user under their respective user document.
 * - /login_events/{loginEventId}: Stores login events.
 *
 * Key Security Decisions:
 * - User data and messages are strictly controlled by path-based ownership.
 * - The login_events collection is not writeable at all via rules.
 * - List operation is not allowed on login_events collection
 * - Read-only collections (e.g., available_games) are publicly readable.
 *
 * Denormalization for Authorization:
 * - The rules rely on path-based authorization for user data and messages, avoiding the need for complex queries or data lookups.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading and writing of game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (create) Authenticated user can create game requests.
     * @allow (get, list) Any user can read game requests.
     * @allow (update, delete) No one can update or delete.
     * @deny (create) Unauthenticated user cannot create game requests.
     * @principle Allows public reads but requires authentication for creation.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Allows public reading of available games.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user can read available games.
     * @deny (create, update, delete) No one can create, update, or delete available games through the client.
     * @principle Allows public reads and denies all writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces user-ownership for user accounts.
     * @path /users/{userId}
     * @allow (create) User can create their own account.
     * @allow (get) User can read their own account.
     * @allow (update) User can update their own account if it exists.
     * @deny (create) User cannot create an account with a mismatched userId.
     * @deny (get) User cannot read another user's account.
     * @deny (update) User cannot update another user's account.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for user messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) User can create messages under their own user ID.
     * @allow (get) User can read their own messages.
     * @allow (list) User can list their own messages.
     * @allow (update, delete) User can update and delete their own messages.
     * @deny (create) User cannot create messages under another user's ID.
     * @deny (get) User cannot read messages under another user's ID.
     * @deny (list) User cannot list messages under another user's ID.
     * @principle Enforces document ownership for messages.
     */
    match /users/{userId}/messages/{messageId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Disables all client-side access to the login_events collection.
      * @path /login_events/{loginEventId}
      * @deny (get, list, create, update, delete) No client-side operations are allowed.
      * @principle Restricts access to login event logs for backend/admin use only.
      */
    match /login_events/{loginEventId} {
       allow get: if false;
       allow list: if false;
       allow create: if false;
       allow update: if false;
       allow delete: if false;
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}