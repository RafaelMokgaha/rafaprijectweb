/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user accounts and game requests,
 * ensuring that only authenticated users can access and modify their own data.
 * Available games are publicly readable but only writeable with appropriate authentication.
 *
 * Data Structure:
 * - /user_accounts/{userId}: Stores profile information for each user, with the document ID matching the Firebase Auth UID.
 * - /users/{userId}/game_requests/{gameRequestId}: Stores game requests made by each user, nested under their user ID.
 *   Each game request document includes a `userAccountId` field for authorization.
 * - /available_games/{gameId}: Stores information about publicly available games.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user account documents.
 * - Users can only create, read, update, and delete their own game request documents.
 * - Available games are publicly readable.
 * - Anyone should be able to create an account.
 * - Data shape is not validated in this ruleset.
 *
 * Denormalization for Authorization:
 * The `GameRequest` documents include the `userAccountId` field, denormalizing the user ID
 * directly onto each request. This allows security rules to validate ownership without
 * needing to perform additional `get()` operations on the `/user_accounts/{userId}` document.
 *
 * Structural Segregation:
 * User-specific game requests are stored under the `/users/{userId}` path, while global available games
 * are stored in the top-level `/available_games` collection. This segregation allows for different
 * security profiles (owner-only vs. public read).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user account documents.
     * @path /user_accounts/{userAccountId}
     * @allow (create) User with matching UID can create their account.
     * @allow (get, update, delete) User with matching UID can read, update, and delete their account.
     * @deny Any other user cannot access this data.
     * @principle Enforces user ownership for account management.
     */
    match /user_accounts/{userAccountId} {
      //isSignedIN, id in resource is equal to request.auth.uid (on create), id in resource is equal to id in resource.data (on update)
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userAccountId);
      allow list: if false;
      allow create: if isOwner(userAccountId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userAccountId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userAccountId);
    }

    /**
     * @description Controls access to game request documents, ensuring only the owner can manage their requests.
     * @path /users/{userAccountId}/game_requests/{gameRequestId}
     * @allow (create) User with matching UID can create game requests under their account.
     * @allow (get, list, update, delete) User with matching UID can read, list, update, and delete their own game requests.
     * @deny Any other user cannot access or modify this data.
     * @principle Enforces user ownership for managing game requests.
     */
    match /users/{userAccountId}/game_requests/{gameRequestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userAccountId);
      allow list: if isOwner(userAccountId);
      allow create: if isOwner(userAccountId) && request.resource.data.userAccountId == request.auth.uid;
      allow update: if isExistingOwner(userAccountId) && request.resource.data.userAccountId == resource.data.userAccountId;
      allow delete: if isExistingOwner(userAccountId);
    }

    /**
     * @description Controls access to available game documents, allowing public read access but restricting writes.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user can read available game information.
     * @deny (create, update, delete) Only authenticated users can create, update, or delete available games.
     * @principle Provides public read access while securing write operations.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}