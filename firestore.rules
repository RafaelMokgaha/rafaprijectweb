/**
 * @fileoverview Firestore Security Rules for the RAFA Project.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages.
 * Public read access is granted to available games and game requests.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /users/{userId}/messages/{messageId}: Stores messages for a specific user, accessible only to that user.
 * - /game_requests/{gameRequestId}: Stores game requests, publicly readable.
 * - /available_games/{availableGameId}: Stores available games, publicly readable.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profiles.
 * - Users can only read and write messages sent to their own inbox.
 * - Listing of documents is enabled only for subcollections of `/users/{userId}` to enable admin replies.
 * - Public read access is granted to the `/game_requests` and `/available_games` collections to allow listing.
 *
 * Denormalization for Authorization:
 *  - Not required, as path-based ownership is sufficient for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (create) User with UID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get) User with UID 'user456' cannot read the profile of user with ID 'user123'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to game request documents.
     * @path /game_requests/{gameRequestId}
     * @allow (get) Any user can read a game request.
     * @allow (list) Any user can list game requests.
     * @allow (create) Any authenticated user can create a game request.
     * @allow (update) Only the owner can update a game request.
     * @allow (delete) Only the owner can delete a game request.
     * @deny (update) User with UID 'user456' cannot update a game request they don't own.
     * @deny (delete) User with UID 'user456' cannot delete a game request they don't own.
     * @principle Allows public read access to game requests, but enforces ownership for writes.
     */
    match /game_requests/{gameRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    /**
     * @description Controls access to available game documents.
     * @path /available_games/{availableGameId}
     * @allow (get) Any user can read an available game.
     * @allow (list) Any user can list available games.
     * @allow (create) Any authenticated user can create an available game.
     * @allow (update) Only the owner can update an available game.
     * @allow (delete) Only the owner can delete an available game.
     * @deny (update) User with UID 'user456' cannot update an available game they don't own.
     * @deny (delete) User with UID 'user456' cannot delete an available game they don't own.
     * @principle Allows public read access to available games, but enforces ownership for writes.
     */
    match /available_games/{availableGameId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    /**
     * @description Controls access to message documents within a user's message inbox.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) User with UID 'user123' can create a message in their own inbox.
     * @allow (get) User with UID 'user123' can read a message in their own inbox.
     * @allow (list) User with UID 'user123' can list messages in their own inbox.
     * @allow (update) User with UID 'user123' can update a message in their own inbox.
     * @allow (delete) User with UID 'user123' can delete a message in their own inbox.
     * @deny (create) User with UID 'user456' cannot create a message in the inbox of user with ID 'user123'.
     * @deny (get) User with UID 'user456' cannot read a message in the inbox of user with ID 'user123'.
     * @principle Enforces document ownership for all operations on user messages.
     */
    match /users/{userId}/messages/{messageId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}