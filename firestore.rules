/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset implements a strict, path-based ownership model for user data, combined with public read access for certain collections.
 *
 * Data Structure:
 * - `/game_requests/{gameRequestId}`: Public collection for game requests.
 * - `/available_games/{availableGameId}`: Public collection for available games.
 * - `/users/{userId}`: User-specific document containing user profile information.
 * - `/users/{userId}/messages/{messageId}`: Subcollection of user-specific messages.
 * - `/login_events/{loginEventId}`: Collection of login events (restricted writes).
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents and message subcollections.
 * - Listing all documents in the `users` collection is disallowed.
 * - `game_requests` and `available_games` collections are publicly readable.
 * - The `login_events` collection requires authentication to create entries.
 *
 * Denormalization for Authorization:
 * - Ownership is enforced via path-based rules (e.g., `/users/{userId}`).
 *
 * Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, while public data is stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game requests, but restricts writes.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Allows public read access but restricts writes.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read available games, but restricts writes.
     * @path /available_games/{availableGameId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Allows public read access but restricts writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows a user to read and write their own user document.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId)
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows a user to read and write their own messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId)
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for all operations within the user's message subcollection.
     */
    match /users/{userId}/messages/{messageId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to create a login event.
     * @path /login_events/{loginEventId}
     * @allow (create): if isSignedIn()
     * @deny (get, list, update, delete): if true
     * @principle Restricts writes to authenticated users only.
     */
    match /login_events/{loginEventId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The ID of the user.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of an existing resource.
     * @param {string} userId The ID of the user.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}