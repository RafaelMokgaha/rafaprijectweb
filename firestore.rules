/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data (user profiles and messages)
 * while allowing public read access to available games and game requests. Login events are write-only,
 * intended for admin monitoring.  No data validation beyond authorization is performed.
 *
 * Data Structure:
 * - /game_requests/{gameRequestId}: Public collection for game requests.
 * - /available_games/{availableGameId}: Public collection for available games.
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/messages/{messageId}: User-specific messages, accessible only by the owning user.
 * - /login_events/{loginEventId}:  Write-only collection for login events; intended for admin monitoring.
 *
 * Key Security Decisions:
 * - Listing of users is explicitly denied.
 * - All writes are protected by authorization checks; `if true` is never used for write operations.
 * - Data validation is minimal in this prototyping phase. Focus is on authorization.
 * - Login Events: No get/list rules are provided to prevent data leakage. These should only be created.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game requests, but restricts writes.
     * @path /game_requests/{gameRequestId}
     * @allow get, list: if true;
     * @allow create: if request.auth != null;
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Allows public read access to game requests, but requires authentication for creating a request.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read available games, but restricts writes.
     * @path /available_games/{availableGameId}
     * @allow get, list: if true;
     * @allow create: if request.auth != null;
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Allows public read access to available games.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages user account data, ensuring only the owner can read/write.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if request.auth.uid == userId;
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces strict user-ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user messages, ensuring only the owner can read/write.
     * @path /users/{userId}/messages/{messageId}
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces strict user-ownership for messages.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
     * @description Allows anyone to create login events for admin monitoring, but restricts all other access.
     * @path /login_events/{loginEventId}
     * @allow create: if true; // Only allow create
     * @deny get: if true;
     * @deny list: if true;
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Limits access to only create for login events, ensuring data is only added, not read, modified, or deleted.
     */
    match /login_events/{loginEventId} {
        allow create: if isSignedIn();
        allow get: if false;
        allow list: if false;
        allow update: if false;
        allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}