/**
 * @description This ruleset enforces a strict user-ownership model for user profiles and messages,
 *              while allowing public read access to available games. Game requests have create, update, and delete
 *              permissions restricted for now.
 * @dataStructure
 *  - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 *  - /users/{userId}/messages/{messageId}: Stores messages for each user, accessible only to the user and admins.
 *  - /game_requests/{gameRequestId}: Stores all game requests.
 *  - /available_games/{availableGameId}: Stores publicly available game information.
 * @keySecurityDecisions
 *  - Users can only access their own profiles and messages.
 *  - Available games are publicly readable, but write access is restricted.
 *  - Listing of users is disallowed.
 * @authorizationIndependence No denormalization is needed as path-based ownership is sufficient for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User with matching UID can read, update, and delete their profile.
     * @deny (create) User cannot create a profile with a different UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages messages for a specific user.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) User can create a message for themselves, admins can create a message for any user.
     * @allow (get, list) User can read their own messages.
     * @deny (create) User cannot create a message for another user unless admin.
     * @deny (get, list) User cannot read another user's messages.
     * @principle Enforces user-specific private data access.
     */
    match /users/{userId}/messages/{messageId} {
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }

    /**
     * @description Manages available games, which are publicly readable.
     * @path /available_games/{availableGameId}
     * @allow (get, list) Any user can read the list of available games.
     * @deny (create, update, delete) Only admins can create, update, and delete games.
     * @principle Allows public read access with owner-only writes.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages game requests.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) Any user can read game requests.
     * @deny (create, update, delete) No one can create, update, or delete game requests for now.
     */
    match /game_requests/{gameRequestId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdmin() {
        return request.auth.token.email == "rafaproject06@gmail.com";
    }
  }
}