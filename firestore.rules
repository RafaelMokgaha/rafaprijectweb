/**
 * @fileoverview Firestore Security Rules for RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, game requests, and user messages.
 * Available games are publicly readable but only writable by admins (not implemented in this prototype).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /users/{userId}/game_requests/{gameRequestId}: Stores game requests, accessible only by the user who created them.
 * - /available_games/{availableGameId}: Stores information about available games, publicly readable.
 * - /users/{userId}/messages/{messageId}: Stores user messages, accessible only by the sender and receiver.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Data validation is relaxed in the prototype to allow for rapid iteration.
 * - All write operations are protected by authorization checks.
 *
 * Denormalization for Authorization:
 * - Game requests and user messages are stored as subcollections of `/users/{userId}` to simplify ownership checks based on the path.
 *   This avoids the need for additional `get()` calls to determine ownership.
 *
 * Structural Segregation:
 * - Available games are stored in a separate top-level collection (`/available_games`) to allow for public read access while restricting write access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.id: 'user123'
     * @allow (get) User with ID 'user123' can read their own profile.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update their own profile.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete their own profile.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456'.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.id: 'user456'
     * @deny (get) User with ID 'user123' cannot read profile of 'user456'.
     *    - request.auth.uid: 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId));
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to game requests made by users.
     * @path /users/{userId}/game_requests/{gameRequestId}
     * @allow (create) User with ID 'user123' can create a game request under their profile.
     *    - request.auth.uid: 'user123'
     * @allow (get) User with ID 'user123' can read a game request under their profile.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update a game request under their profile.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete a game request under their profile.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user123' cannot create a game request under 'user456' profile.
     *    - request.auth.uid: 'user123'
     * @deny (get) User with ID 'user123' cannot read a game request under 'user456' profile.
     *    - request.auth.uid: 'user456'
     * @principle Restricts access to a user's own game requests.
     */
    match /users/{userId}/game_requests/{gameRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId)/game_requests/$(gameRequestId));
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to available games.
     * @path /available_games/{availableGameId}
     * @allow (get) Any user can read information about available games.
     *    - request.auth.uid: null (or any user ID)
     * @deny (create) Non-admin user cannot create available games.
     *    - request.auth.uid: 'user123'
     * @principle Allows public read access to available games.
     */
    match /available_games/{availableGameId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add admin role check once implemented.
      allow update: if false; // TODO: Add admin role check once implemented.
      allow delete: if false; // TODO: Add admin role check once implemented.
    }

     /**
     * @description Controls access to messages sent between users.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) User with ID 'user123' can create a message under their profile.
     *    - request.auth.uid: 'user123'
     * @allow (get) User with ID 'user123' can read a message under their profile if they are the sender or receiver.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update a message under their profile if they are the sender or receiver.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete a message under their profile if they are the sender.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user123' cannot create a message under 'user456' profile.
     *    - request.auth.uid: 'user123'
     * @deny (get) User with ID 'user123' cannot read a message under 'user456' profile if they are not the sender or receiver.
     *    - request.auth.uid: 'user456'
     * @principle Restricts access to a user's own messages and messages they are a part of.
     */
    match /users/{userId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId)/messages/$(messageId));
      }
      
      // TODO: Need to validate senderId/receiverId in the request.resource.data

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId); // Requires the data to have userId
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}