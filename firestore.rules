/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and messages,
 * with public read access for available games and game requests. All write operations
 * require authentication and proper authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Each user can only access their own profile.
 * - /game_requests/{gameRequestId}: Stores user game requests. Publicly readable, owner-only writes.
 * - /available_games/{availableGameId}: Stores information about available games. Publicly readable, owner-only writes.
 * - /users/{userId}/messages/{messageId}: Stores messages sent to a specific user. Only the user can access their messages.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed by the structure.
 * - Available games and game requests are publicly readable but only modifiable by authenticated users.
 * - All write operations require a verified user identity (request.auth != null).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profile data based on ownership.
     * @path /users/{userId}
     * @allow (create) - If the user's UID matches the userId in the path.
     * @allow (get, update, delete) - If the user's UID matches the userId in the path and the document exists.
     * @deny (create) - If the user's UID does not match the userId in the path.
     * @deny (get, update, delete) - If the user's UID does not match the userId in the path, or the document does not exist.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to game requests, but restricts write access to authenticated users only.
     * @path /game_requests/{gameRequestId}
     * @allow (get, list) - Any user can read available game requests.
     * @allow (create) - If the request is authenticated.
     * @allow (update, delete) - If the request is authenticated and the user is the owner.
     * @deny (create, update, delete) - If the request is not authenticated.
     * @principle Allows public reads, but enforces ownership for all writes.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

     /**
      * @description Allows public read access to available games, but restricts write access to authenticated users only.
      * @path /available_games/{availableGameId}
      * @allow (get, list) - Any user can read available games.
      * @allow (create) - If the request is authenticated.
      * @allow (update, delete) - If the request is authenticated and the user is the owner.
      * @deny (create, update, delete) - If the request is not authenticated.
      * @principle Allows public reads, but enforces ownership for all writes.
      */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows access to messages for a specific user based on ownership.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create, get, update, delete) - If the user's UID matches the userId in the path.
     * @deny (create, get, update, delete) - If the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/messages/{messageId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}