/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data,
 * while allowing public read access to collections intended for general consumption.
 *
 * Data Structure:
 * - `/game_requests/{gameRequestId}`: Stores game requests (no user-specific access control).
 * - `/available_games/{availableGameId}`: Stores available games (publicly readable).
 * - `/users/{userId}`: Stores user account information (owner-only access).
 * - `/users/{userId}/messages/{messageId}`: Stores user messages (owner-only access).
 * - `/login_events/{loginEventId}`: Stores login events (no user-specific access control).
 *
 * Key Security Decisions:
 * - User listing is disabled for the `/users` collection.
 * - Read-only collections like `/available_games` are publicly readable.
 * - Ambiguous relationships default to strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure game requests submitted by users.
     * @path /game_requests/{gameRequestId}
     * @allow (create) - Any authenticated user can create a game request.
     * @allow (get, list) - Any user can list and get the available games.
     * @deny (update, delete) - No user can update or delete a game request.
     * @principle Allows public read access to available games, but restricts modifications.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secure available games information.
     * @path /available_games/{availableGameId}
     * @allow (get, list) - Any user can list and get the available games.
     * @deny (create, update, delete) - No user can create, update, or delete available games.
     * @principle Allows public read access to available games, but restricts modifications.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforce owner-only access for user account data.
     * @path /users/{userId}
     * @allow (create) - Only the user with the matching UID can create their own document.
     * @allow (get) - Only the user with the matching UID can read their own document.
     * @deny (list) - Listing users is not allowed.
     * @deny (update, delete) - Only the user with the matching UID can update or delete their own document.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforce owner-only access for user messages.
     * @path /users/{userId}/messages/{messageId}
     * @allow (create) - Only the owner can create a new message in their collection.
     * @allow (get) - Only the owner can read their own messages.
     * @allow (list) - Only the owner can list their own messages.
     * @deny (update, delete) - Only the owner can update or delete their own messages.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/messages/{messageId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Log user login events for admin monitoring.
     * @path /login_events/{loginEventId}
     * @allow (create) - Any authenticated user can trigger a login event.
     * @allow (get, list) - Any user can get and list the login events.
     * @deny (update, delete) - No user can update or delete a login event.
     */
    match /login_events/{loginEventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}