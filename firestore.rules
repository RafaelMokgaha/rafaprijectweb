/**
 * @fileoverview Firestore Security Rules for the RAFA Project Launcher application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data while allowing public read access to certain collections.
 *
 * Data Structure:
 * - `/game_requests/{gameRequestId}`: Stores game requests submitted by users.
 * - `/available_games/{availableGameId}`: Stores information about available games.
 * - `/users/{userId}`: Stores user account information, with `userId` matching the Firebase auth UID.
 * - `/users/{userId}/messages/{messageId}`: Stores messages for each user, nested under their respective user ID.
 * - `/login_events/{loginEventId}`: Stores login events.
 *
 * Key Security Decisions:
 * - User data and messages are strictly controlled by user ownership.
 * - Listing of user messages is only allowed by the owner.
 * - Game requests and available games are publicly readable.
 *
 * Denormalization for Authorization:
 * - User messages are stored in a subcollection of the user document, enabling path-based ownership and avoiding the need for `get()` calls to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to game requests and restricts write access.
     * @path /game_requests/{gameRequestId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     *
     * @principle Allows public reads for all users to see the game requests. No write permissions are granted.
     */
    match /game_requests/{gameRequestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to available games and restricts write access.
     * @path /available_games/{availableGameId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Allows public reads for all users to see the available games. No write permissions are granted.
     */
    match /available_games/{availableGameId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts access to user documents to the owner of the account.
     * @path /users/{userId}
     * @allow get: if isSignedIn() && isOwner(userId);
     * @allow list: if false;
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow update: if isSignedIn() && isExistingOwner(userId);
     * @allow delete: if isSignedIn() && isExistingOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Restricts access to user messages to the owner of the account.
     * @path /users/{userId}/messages/{messageId}
     * @allow get: if isSignedIn() && isOwner(userId);
     * @allow list: if isSignedIn() && isOwner(userId);
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow update: if isSignedIn() && isExistingOwner(userId);
     * @allow delete: if isSignedIn() && isExistingOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Restricts access to login events.
     * @path /login_events/{loginEventId}
     * @allow get, list: if false;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Login events cannot be accessed by the users.
     */
    match /login_events/{loginEventId} {
        allow get, list, create, update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}